# OptiVaults Frontend Environment
# Copy to .env and fill in values

# Network: preprod | mainnet
VITE_NETWORK=preprod

# Blockfrost API key (project_id) — required for direct chain access.
# Free tier: 50,000 requests/day per key. Sign up at https://blockfrost.io.
# Users can also override this at runtime via the Settings page (BYO key).
VITE_BLOCKFROST_API_KEY=

# Optional override for the deploy-state JSON URL. Defaults to
# `${BASE_URL}/v1-deploy-state.json` (sibling of index.html). Operators
# publish their ceremony state JSON here so the frontend can resolve
# vault NFT policy / ref-script outRefs / staking validator hashes
# at startup. Same file shape as `keeper/data/preprod-<release>.json`.
# VITE_DEPLOY_STATE_URL=https://cdn.example.com/optivaults/v1-state.json

# Optional R2 / static-CDN base URL for keeper-published history JSONL
# (vault-history.jsonl, apy-history.jsonl, keeper-actions/<pkh>.jsonl).
# When unset, the frontend falls back to chain-walk + IndexedDB cache
# for KeeperHistory and renders only the on-chain "Accruing in Liqwid"
# line on the APY chart. Multi-keeper aggregation: list keeper PKHs in
# the deploy-state JSON's `historyKeepers` field.
# VITE_HISTORY_BASE_URL=https://pub-<id>.r2.dev

# ──────────────────────────────────────────────────────────────────
# V1 deployment anchors — populated after every fresh ceremony.
# These are read by `src/lib/v1Config.ts` (alternative to fork-editing
# the in-source presets). Operators forking for their own instance
# only need to set these env vars at build time; the React app will
# pick them up via Vite's `import.meta.env`.
# ──────────────────────────────────────────────────────────────────

# Bech32 — vault UTXO address (proxy script address).
VITE_PROXY_ADDR=

# Hex28 — one-shot vault NFT minting policy.
VITE_VAULT_NFT_POLICY=

# Hex — vault NFT asset name (default "OptiVault" = 4f7074695661756c74).
# Override only if your ceremony minted under a different name.
# VITE_VAULT_NFT_NAME=4f7074695661756c74

# Hex28 — vUSDCx share-token minting policy.
VITE_VUSDCX_POLICY=

# Hex — vUSDCx asset name (default "vUSDCx" = 765553444378).
# VITE_VUSDCX_NAME=765553444378

# Hex28 — deposit-token (USDCx) policy. Mainnet defaults to Circle xReserve.
# VITE_DEPOSIT_TOKEN_POLICY=

# Hex — deposit-token asset name. Mainnet "USDCx" = 5553444378.
# VITE_DEPOSIT_TOKEN_NAME=

# Bech32 — registry script (used for governance + market lookups).
VITE_REGISTRY_ADDR=

# Hex28 — registry auth NFT policy.
VITE_REGISTRY_AUTH_POLICY=

# Hex28 — Liqwid MarketState NFT policy. Empty disables on-chain APY
# (Dashboard / ApyChart fall back to "pending"). Set to the policy of
# the primary Liqwid market (DJED / USDM / etc.) used by your strategy.
VITE_LIQWID_MARKET_POLICY=
