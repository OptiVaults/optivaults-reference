{
  "name": "@optivaults/v1-frontend",
  "version": "0.1.0",
  "description": "V1 React/Vite SPA frontend for the OptiVaults non-custodial yield vault on Cardano — CIP-30 wallet integration, in-browser TX building, vault state via Blockfrost, self-serve emergency-withdraw path. Pre-launch; companion to optivaults-protocol (Aiken validators).",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/OptiVaults/optivaults-reference",
  "repository": {
    "type": "git",
    "url": "https://github.com/OptiVaults/optivaults-reference.git",
    "directory": "frontend"
  },
  "bugs": {
    "url": "https://github.com/OptiVaults/optivaults-reference/issues"
  },
  "keywords": [
    "cardano",
    "defi",
    "stablecoin",
    "yield-vault",
    "optivaults",
    "vite",
    "react",
    "cip-30",
    "lucid-evolution"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/inject-buffer-polyfill.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lucid-evolution/lucid": "^0.4.29",
    "buffer": "^6.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "rollup": "^4.60.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.2"
  }
