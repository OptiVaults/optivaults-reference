<?xml version="1.0" encoding="UTF-8"?>
<!--
  Operator-specific. Default URLs target the OptiVaults-operated instance.
  Operators forking this repo and running their own instance should replace
  the host (`v1.optivaults.app`) with their own domain, and update
  `lastmod` on each deploy.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://v1.optivaults.app/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://v1.optivaults.app/deposit</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://v1.optivaults.app/withdraw</loc>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://v1.optivaults.app/history</loc>
    <changefreq>daily</changefreq>
    <priority>0.7</priority>
  </url>
</urlset>
